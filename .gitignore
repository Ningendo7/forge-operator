# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Kubeconfig might contain secrets
*.kubeconfig

# Terraform sensitive and local artifacts
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
backend.tfvars

# Local-only variable files often contain secrets
*.tfvars
*.tfvars.json

# ...except the per-environment tfvars checked into environments/*/, which
# hold no secrets by design (only sizing/naming/CIDR config) and are meant
# to be tracked so `terraform apply -var-file=<env>.tfvars` works out of the box.
!**/dev.tfvars
!**/prod.tfvars

# CLI and local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI config may include credentials
.terraformrc
terraform.rc

# Scratch output of `kubebuilder edit --plugins=helm/v2-alpha`. Once
# charts/chart has hand-customizations the plugin doesn't recognize, it
# safely diverts its regenerated output here instead of overwriting
# charts/chart directly. Diff this against charts/chart and merge deliberately
# rather than committing it wholesale.
dist/chart/
